# Settings for running AyiPM on a server. Local development doesn't need this file.
# Copy it to .env next to compose.yaml, fill it in, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Docker Compose reads .env by itself. See docs/self-hosting.md.

# Use the production settings in compose.prod.yaml together with compose.yaml, and start the
# backend and frontend too, so plain `docker compose` commands work on the server.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
COMPOSE_PROFILES=app

# Password of the ayipm database user. Generate one with: openssl rand -hex 32
DATABASE_PASSWORD=

# The frontend listens on 127.0.0.1 at this port. Point your reverse proxy at it.
FRONTEND_PORT=3000

# The address people open AyiPM at, such as https://ayipm.example.com. Links in emails point here,
# and so does sign-in with Google. Empty means http://localhost:3000.
PUBLIC_URL=

# Optional: "Continue with Google". Create a web client in Google Cloud whose redirect URI is
# PUBLIC_URL followed by /api/auth/google/callback; see "Sign in with Google" in the README.
# Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Real email delivery via SMTP (e.g. Gmail, SendGrid, Amazon SES, Resend, Mailgun).
# Without SPRING_MAIL_HOST, emails are not delivered to inboxes and are printed to the backend terminal log instead.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SSL_ENABLED=false
MAIL_FROM=
